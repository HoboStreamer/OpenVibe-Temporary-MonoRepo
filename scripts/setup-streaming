#!/usr/bin/env bash
# setup-streaming — interactive setup + validation for the OpenVibe streaming stack
# Writes into services/openre-stream/.env and services/openvibe-live/.env
# Run from repo root: bash scripts/setup-streaming

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STREAM_ENV="$REPO_ROOT/services/openre-stream/.env"
LIVE_ENV="$REPO_ROOT/services/openvibe-live/.env"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLD='\033[1m'
RST='\033[0m'

pass() { echo -e "  ${GRN}✓${RST}  $*"; }
fail() { echo -e "  ${RED}✗${RST}  $*"; FAILURES=$((FAILURES+1)); }
warn() { echo -e "  ${YLW}!${RST}  $*"; }
header() { echo -e "\n${BLD}$*${RST}"; }

FAILURES=0

# ── helpers ──────────────────────────────────────────────────────────────────

# Read a key from an .env file; empty string if missing
env_get() {
    local file="$1" key="$2"
    grep -E "^${key}=" "$file" 2>/dev/null | tail -1 | cut -d= -f2- | sed "s/^['\"]//;s/['\"]$//"
}

# Set or replace a key in an .env file
env_set() {
    local file="$1" key="$2" value="$3"
    if grep -qE "^${key}=" "$file" 2>/dev/null; then
        # replace in-place
        sed -i "s|^${key}=.*|${key}=${value}|" "$file"
    else
        echo "${key}=${value}" >> "$file"
    fi
}

# Prompt user for a value; show current value as default
prompt() {
    local label="$1" current="$2" var_name="$3"
    local display_current="${current:-<not set>}"
    echo -ne "  ${label} [${display_current}]: "
    read -r input
    if [[ -n "$input" ]]; then
        eval "$var_name=\"\$input\""
    else
        eval "$var_name=\"\$current\""
    fi
}

# Detect public IP of this machine
detect_public_ip() {
    curl -s --max-time 4 https://api.ipify.org 2>/dev/null \
        || curl -s --max-time 4 https://checkip.amazonaws.com 2>/dev/null \
        || echo ""
}

# ── ensure .env files exist ──────────────────────────────────────────────────

init_env() {
    local service="$1" env_file="$2" example_file="${2%.env}/.env.example"
    if [[ ! -f "$env_file" ]]; then
        if [[ -f "$example_file" ]]; then
            cp "$example_file" "$env_file"
            echo "  Created $env_file from example"
        else
            touch "$env_file"
            echo "  Created empty $env_file"
        fi
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# SETUP MODE
# ═══════════════════════════════════════════════════════════════════════════

run_setup() {
    echo -e "\n${BLD}━━━  OpenVibe Streaming Setup  ━━━${RST}"
    echo "This will write to:"
    echo "  $STREAM_ENV"
    echo "  $LIVE_ENV"
    echo ""

    init_env "openre-stream" "$STREAM_ENV"
    init_env "openvibe-live" "$LIVE_ENV"

    # ── 1. Internal API key ──────────────────────────────────────────────────
    header "1/6  Internal API key  (must match across all services)"

    current_key=$(env_get "$STREAM_ENV" "INTERNAL_API_KEY")
    if [[ "$current_key" == "change-me-in-production" || -z "$current_key" ]]; then
        echo "  Generating a random key..."
        current_key=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32)
    fi
    prompt "INTERNAL_API_KEY" "$current_key" api_key
    env_set "$STREAM_ENV" "INTERNAL_API_KEY" "$api_key"
    env_set "$LIVE_ENV"   "INTERNAL_API_KEY" "$api_key"
    # also set it in any other .env files that have INTERNAL_API_KEY
    for f in "$REPO_ROOT"/services/*/.env; do
        [[ "$f" == "$STREAM_ENV" || "$f" == "$LIVE_ENV" ]] && continue
        [[ -f "$f" ]] && grep -qE "^INTERNAL_API_KEY=" "$f" && env_set "$f" "INTERNAL_API_KEY" "$api_key"
    done
    echo "  → Written to all service .env files"

    # ── 2. VPS public IP ────────────────────────────────────────────────────
    header "2/6  VPS public IP  (used for mediasoup ICE)"

    echo "  Detecting public IP..."
    detected_ip=$(detect_public_ip)
    current_ip=$(env_get "$STREAM_ENV" "MEDIASOUP_ANNOUNCED_IP")
    [[ -z "$current_ip" || "$current_ip" == "40.160.240.222" ]] && current_ip="$detected_ip"
    prompt "MEDIASOUP_ANNOUNCED_IP" "$current_ip" announced_ip
    env_set "$STREAM_ENV" "MEDIASOUP_ANNOUNCED_IP" "$announced_ip"

    # ── 3. OPENVIBE_LIVE_URL in openre-stream ───────────────────────────────
    header "3/6  openvibe-live URL  (for RTMP→live push from openre-stream)"

    current_live_url=$(env_get "$STREAM_ENV" "OPENVIBE_LIVE_URL")
    [[ -z "$current_live_url" ]] && current_live_url="http://127.0.0.1:4600"
    prompt "OPENVIBE_LIVE_URL (openre-stream env)" "$current_live_url" live_url
    env_set "$STREAM_ENV" "OPENVIBE_LIVE_URL" "$live_url"

    # ── 4. TURN server ──────────────────────────────────────────────────────
    header "4/6  TURN server  (optional — needed for mobile/strict-NAT viewers)"
    echo "  Leave blank to skip. Set TURN_URL, TURN_USERNAME, TURN_CREDENTIAL in openvibe-live."

    current_turn_url=$(env_get "$LIVE_ENV" "TURN_URL")
    prompt "TURN_URL (e.g. turn:your-vps:3478)" "$current_turn_url" turn_url
    if [[ -n "$turn_url" ]]; then
        current_turn_user=$(env_get "$LIVE_ENV" "TURN_USERNAME")
        prompt "TURN_USERNAME" "$current_turn_user" turn_user
        current_turn_cred=$(env_get "$LIVE_ENV" "TURN_CREDENTIAL")
        prompt "TURN_CREDENTIAL" "$current_turn_cred" turn_cred
        env_set "$LIVE_ENV" "TURN_URL"        "$turn_url"
        env_set "$LIVE_ENV" "TURN_USERNAME"   "$turn_user"
        env_set "$LIVE_ENV" "TURN_CREDENTIAL" "$turn_cred"
        echo "  → TURN config written to openvibe-live .env"
    else
        warn "Skipped — viewers behind strict NAT may not connect"
    fi

    # ── 5. ffmpeg ───────────────────────────────────────────────────────────
    header "5/6  ffmpeg binary  (for recording/VODs)"

    ffmpeg_bin=$(env_get "$STREAM_ENV" "FFMPEG_BIN")
    if [[ -z "$ffmpeg_bin" ]]; then
        # auto-detect
        ffmpeg_bin=$(command -v ffmpeg 2>/dev/null || echo "")
        [[ -z "$ffmpeg_bin" ]] && ffmpeg_bin="/usr/bin/ffmpeg"
    fi
    prompt "FFMPEG_BIN" "$ffmpeg_bin" ffmpeg_path
    if [[ "$ffmpeg_path" != "/usr/bin/ffmpeg" ]]; then
        env_set "$STREAM_ENV" "FFMPEG_BIN" "$ffmpeg_path"
        echo "  → FFMPEG_BIN written to openre-stream .env"
    else
        echo "  → Using default /usr/bin/ffmpeg (no env var needed)"
    fi

    # ── 6. UDP firewall reminder ─────────────────────────────────────────────
    header "6/6  Firewall  (UDP 12000–12300 for mediasoup WebRTC)"
    echo "  This script cannot open firewall ports for you."
    echo "  Run one of these on your VPS if not done already:"
    echo ""
    echo "    ufw allow 12000:12300/udp"
    echo "    # or"
    echo "    iptables -A INPUT -p udp --dport 12000:12300 -j ACCEPT"
    echo "    # or"
    echo "    firewall-cmd --add-port=12000-12300/udp --permanent && firewall-cmd --reload"

    echo ""
    echo -e "${GRN}${BLD}Setup complete.${RST} Running validation...\n"
    run_validate
}

# ═══════════════════════════════════════════════════════════════════════════
# VALIDATE MODE
# ═══════════════════════════════════════════════════════════════════════════

run_validate() {
    echo -e "${BLD}━━━  OpenVibe Streaming Validation  ━━━${RST}\n"

    # ── openre-stream .env ───────────────────────────────────────────────────
    header "openre-stream .env  ($STREAM_ENV)"

    if [[ ! -f "$STREAM_ENV" ]]; then
        fail ".env file missing — run setup first"
    else
        # MEDIASOUP_ANNOUNCED_IP
        ip_val=$(env_get "$STREAM_ENV" "MEDIASOUP_ANNOUNCED_IP")
        if [[ -z "$ip_val" ]]; then
            fail "MEDIASOUP_ANNOUNCED_IP not set — WebRTC ICE will use wrong IP"
        elif [[ "$ip_val" == "40.160.240.222" ]]; then
            warn "MEDIASOUP_ANNOUNCED_IP is still the placeholder (40.160.240.222) — update to your VPS IP"
        else
            pass "MEDIASOUP_ANNOUNCED_IP=$ip_val"
        fi

        # INTERNAL_API_KEY
        key_val=$(env_get "$STREAM_ENV" "INTERNAL_API_KEY")
        if [[ -z "$key_val" || "$key_val" == "change-me-in-production" ]]; then
            fail "INTERNAL_API_KEY is default or unset — service-to-service calls will fail"
        else
            pass "INTERNAL_API_KEY set (${#key_val} chars)"
        fi

        # OPENVIBE_LIVE_URL
        live_url_val=$(env_get "$STREAM_ENV" "OPENVIBE_LIVE_URL")
        if [[ -z "$live_url_val" ]]; then
            fail "OPENVIBE_LIVE_URL not set — RTMP stream.started/ended won't reach openvibe-live"
        else
            pass "OPENVIBE_LIVE_URL=$live_url_val"
        fi

        # OPENVIBE_EVENTS_URL
        events_url=$(env_get "$STREAM_ENV" "OPENVIBE_EVENTS_URL")
        if [[ -z "$events_url" ]]; then
            warn "OPENVIBE_EVENTS_URL not set — WHIP event delivery may fail (RTMP is fine without it)"
        else
            pass "OPENVIBE_EVENTS_URL=$events_url"
        fi

        # UDP port range
        min_port=$(env_get "$STREAM_ENV" "MEDIASOUP_MIN_PORT")
        max_port=$(env_get "$STREAM_ENV" "MEDIASOUP_MAX_PORT")
        [[ -z "$min_port" ]] && min_port=12000
        [[ -z "$max_port" ]] && max_port=12300
        pass "Mediasoup port range: UDP $min_port–$max_port (verify firewall allows these)"
    fi

    # ── openvibe-live .env ───────────────────────────────────────────────────
    header "openvibe-live .env  ($LIVE_ENV)"

    if [[ ! -f "$LIVE_ENV" ]]; then
        fail ".env file missing — run setup first"
    else
        # INTERNAL_API_KEY — must match openre-stream
        live_key=$(env_get "$LIVE_ENV" "INTERNAL_API_KEY")
        stream_key=$(env_get "$STREAM_ENV" "INTERNAL_API_KEY")
        if [[ -z "$live_key" || "$live_key" == "change-me-in-production" ]]; then
            fail "INTERNAL_API_KEY is default or unset in openvibe-live"
        elif [[ "$live_key" != "$stream_key" ]]; then
            fail "INTERNAL_API_KEY mismatch between openvibe-live and openre-stream — all service calls will 401"
        else
            pass "INTERNAL_API_KEY matches openre-stream"
        fi

        # OPENRE_STREAM_URL
        restream_url=$(env_get "$LIVE_ENV" "OPENRE_STREAM_URL")
        if [[ -z "$restream_url" ]]; then
            fail "OPENRE_STREAM_URL not set — go-live page can't reach openre-stream"
        else
            pass "OPENRE_STREAM_URL=$restream_url"
        fi

        # TURN config
        turn_url=$(env_get "$LIVE_ENV" "TURN_URL")
        if [[ -z "$turn_url" ]]; then
            warn "TURN_URL not set — viewers on mobile/strict NAT may fail to connect"
        else
            turn_user=$(env_get "$LIVE_ENV" "TURN_USERNAME")
            turn_cred=$(env_get "$LIVE_ENV" "TURN_CREDENTIAL")
            if [[ -z "$turn_user" || -z "$turn_cred" ]]; then
                warn "TURN_URL set but TURN_USERNAME or TURN_CREDENTIAL missing"
            else
                pass "TURN configured: $turn_url (user=$turn_user)"
            fi
        fi
    fi

    # ── binaries ─────────────────────────────────────────────────────────────
    header "Binaries"

    ffmpeg_bin_env=$(env_get "$STREAM_ENV" "FFMPEG_BIN" 2>/dev/null)
    ffmpeg_bin="${ffmpeg_bin_env:-/usr/bin/ffmpeg}"
    if command -v ffmpeg &>/dev/null; then
        pass "ffmpeg found: $(command -v ffmpeg) ($(ffmpeg -version 2>&1 | head -1 | awk '{print $3}'))"
    elif [[ -x "$ffmpeg_bin" ]]; then
        pass "ffmpeg at $ffmpeg_bin"
    else
        warn "ffmpeg not found at $ffmpeg_bin — recording/VODs will fail (live streaming still works)"
    fi

    # node-media-server
    nms_path="$REPO_ROOT/services/openre-stream/node_modules/node-media-server"
    if [[ -d "$nms_path" ]]; then
        pass "node-media-server installed"
    else
        fail "node-media-server not installed in services/openre-stream — RTMP disabled (run: npm install in that dir)"
    fi

    # ── connectivity checks ──────────────────────────────────────────────────
    header "Reachability  (requires services to be running)"

    check_http() {
        local label="$1" url="$2"
        local status
        status=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "$url" 2>/dev/null || echo "000")
        if [[ "$status" == "000" ]]; then
            warn "$label — not reachable (is the service running?)"
        elif [[ "$status" -ge 500 ]]; then
            warn "$label — HTTP $status"
        else
            pass "$label — HTTP $status"
        fi
    }

    stream_base="${restream_url:-http://127.0.0.1:4700}"
    live_base=$(env_get "$LIVE_ENV" "PUBLIC_BASE_URL" 2>/dev/null)
    [[ -z "$live_base" ]] && live_base="http://127.0.0.1:4600"

    check_http "openre-stream health" "$stream_base/health"
    check_http "openvibe-live health" "$live_base/health"

    # ── summary ──────────────────────────────────────────────────────────────
    echo ""
    if [[ "$FAILURES" -eq 0 ]]; then
        echo -e "${GRN}${BLD}All checks passed.${RST}"
    else
        echo -e "${RED}${BLD}$FAILURES check(s) failed.${RST} Fix the issues above, then re-run: bash scripts/setup-streaming validate"
        exit 1
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# ENTRYPOINT
# ═══════════════════════════════════════════════════════════════════════════

MODE="${1:-}"

case "$MODE" in
    validate|check)
        run_validate
        ;;
    setup|"")
        run_setup
        ;;
    *)
        echo "Usage: bash scripts/setup-streaming [setup|validate]"
        echo "  setup    — interactive setup + validate (default)"
        echo "  validate — validate current config only"
        exit 1
        ;;
esac
