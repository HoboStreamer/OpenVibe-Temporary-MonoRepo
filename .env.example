# OpenVibe workspace-level example env. Each service has its own .env.example.
# Values listed here are the cross-service ones every component honors.

# Shared internal API key. MUST match between openvibe-network, openvibe-events,
# the legacy hobo-tools install, and HoboStreamer if the streamer is wired in.
INTERNAL_API_KEY=change-me-in-production

# OpenVibe public surface URLs (override per environment).
OPENVIBE_NETWORK_URL=http://localhost:4100
OPENVIBE_EVENTS_URL=http://localhost:4400
OPENVIBE_AUTH_URL=http://localhost:4100
OPENVIBE_API_URL=http://localhost:4100
OPENVIBE_ADMIN_URL=http://localhost:4100
OPENVIBE_MY_URL=http://localhost:4100
OPENVIBE_THEMES_URL=http://localhost:4100

# Phase 3 / Phase 4 service URLs (advertised via the URL registry).
OPENVIBE_MEDIA_URL=http://localhost:4500
OPENVIBE_MEDIA_INTERNAL_URL=http://localhost:4500
OPENVIBE_LIVE_URL=http://localhost:4600
OPENVIBE_LIVE_INTERNAL_URL=http://localhost:4600
OPENRE_STREAM_URL=http://localhost:4700
OPENRE_STREAM_INTERNAL_URL=http://localhost:4700

# Federation with the legacy hobo.tools install.
# Leave unset to run the OpenVibe network standalone (issuer of record).
HOBO_TOOLS_URL=
HOBO_TOOLS_INTERNAL_URL=
HOBO_TOOLS_PUBLIC_KEY=
