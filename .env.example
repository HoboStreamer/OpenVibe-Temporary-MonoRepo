# OpenVibe workspace-level example env. Each service has its own .env.example.
# Values listed here are the shared, cross-service environment variables every
# component honors.

# Shared internal API key used by all OpenVibe services.
INTERNAL_API_KEY=change-me-in-production

# Core OpenVibe public surface URLs. Override these per environment if needed.
OPENVIBE_NETWORK_URL=http://localhost:4100
OPENVIBE_EVENTS_URL=http://localhost:4400
OPENVIBE_AUTH_URL=http://localhost:4100
OPENVIBE_API_URL=http://localhost:4100
OPENVIBE_ADMIN_URL=http://localhost:4100
OPENVIBE_MY_URL=http://localhost:4100
OPENVIBE_THEMES_URL=http://localhost:4100

# Phase 3 / Phase 4 service URLs.
OPENVIBE_MEDIA_URL=http://localhost:4500
OPENVIBE_MEDIA_INTERNAL_URL=http://localhost:4500
OPENVIBE_LIVE_URL=http://localhost:4600
OPENVIBE_LIVE_INTERNAL_URL=http://localhost:4600
OPENRE_STREAM_URL=http://localhost:4700
OPENRE_STREAM_INTERNAL_URL=http://localhost:4700

# Phase 5 / Phase 6 / Phase 7 service URLs.
OPENVIBE_CHAT_URL=http://localhost:4800
OPENVIBE_COMMUNITY_URL=http://localhost:4900
OPENVIBE_BILLING_URL=http://localhost:5000
OPENVIBE_AI_URL=http://127.0.0.1:5100
OPENVIBE_AI_INTERNAL_URL=http://127.0.0.1:5100
OPENVIBE_GAMES_URL=http://127.0.0.1:5200
OPENVIBE_GAMES_INTERNAL_URL=http://127.0.0.1:5200
OPENVIBE_WORKERS_URL=http://127.0.0.1:5300
OPENVIBE_WORKERS_INTERNAL_URL=http://127.0.0.1:5300
OPENVIBE_REALTIME_URL=http://127.0.0.1:5400
OPENVIBE_REALTIME_INTERNAL_URL=http://127.0.0.1:5400
OPENVIBE_CODES_URL=http://127.0.0.1:5500
OPENVIBE_BLOG_URL=http://127.0.0.1:5500
OPENVIBE_WIKI_URL=http://127.0.0.1:5500
OPENVIBE_NEWS_URL=http://127.0.0.1:5500
OPENVIBE_REVIEWS_URL=http://127.0.0.1:5500
OPENVIBE_DEALS_URL=http://127.0.0.1:5500
OPENVIBE_COUPONS_URL=http://127.0.0.1:5500
OPENVIBE_TRADE_URL=http://127.0.0.1:5500
AI_OPENVIBE_NETWORK_HOST=ai.openvibe.network

# openvibe-ai defaults.
AI_DEFAULT_PROVIDER=stub
AI_DEFAULT_ROUTE=default.chat
AI_DEFAULT_PER_MINUTE=120
AI_DEFAULT_PER_DAY=20000
AI_CACHE_TTL_SECONDS=900
AI_DEBUG_PROMPT_LOGGING=0

# Legacy Hobo migration inputs.
# Leave unset for normal OpenVibe runtime. These are only for migration,
# archival verification, or explicit one-off compatibility diagnostics.
HOBO_TOOLS_URL=
HOBO_TOOLS_INTERNAL_URL=
HOBO_TOOLS_PUBLIC_KEY=

# Optional external content / AI provider keys referenced by ENV NAME ONLY in the DB.
OPENVIBE_NEWSAPI_KEY=
OPENVIBE_YOUTUBE_API_KEY=
OPENVIBE_REDDIT_CLIENT_ID=
OPENVIBE_EBAY_CLIENT_ID=
OPENVIBE_ALPHA_VANTAGE_API_KEY=
OPENVIBE_COINGECKO_API_KEY=
OPENVIBE_FINNHUB_API_KEY=
OPENVIBE_RAKUTEN_COUPON_API_TOKEN=
FONTAWESOME_PACKAGE_TOKEN=

# Optional AI provider keys. Un-comment the provider you want to use.
# OPENVIBE_AI_OPENAI_API_KEY=
# OPENVIBE_AI_ANTHROPIC_API_KEY=
# OPENVIBE_AI_GEMINI_API_KEY=
# OPENVIBE_AI_OPENROUTER_API_KEY=
# OPENVIBE_AI_LOCAL_HTTP_URL=

# ─────────────────── Phase 8: native runtime + migration ───────────────────
# Default Phase 8 stance is OpenVibe-native: every service runs without any
# hobo.* dependency. Set OPENVIBE_LEGACY_COMPAT_MODE=true only to federate.
OPENVIBE_ENV=local
OPENVIBE_LEGACY_COMPAT_MODE=false

# Persistence selection.
# - sqlite: local / dev mode.
# - postgres: staging / production mode.
# - staging: the staging importer path.
OPENVIBE_PERSISTENCE_MODE=sqlite
OPENVIBE_DATABASE_URL=
OPENVIBE_STAGING_DATABASE_URL=

# Redis and queue coordination.
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

# Distributed worker / realtime defaults.
# These are optional for single-node local development; they become required
# once Redis-backed queues are enabled.
OPENVIBE_MEDIA_USE_WORKERS=false
OPENVIBE_MEDIA_PROCESSING_QUEUE=media-processing
OPENVIBE_WORKER_ENABLE_PROCESSORS=false
OPENVIBE_WORKER_QUEUES=media,ai,notifications
OPENVIBE_REALTIME_ALLOW_ANONYMOUS=true

# Media storage topology.
# Hot tier is local SQLite + filesystem; cold tier is off until a provider is set.
OPENVIBE_MEDIA_HOT_ROOT=./data/media-hot
OPENVIBE_MEDIA_MULTIPART_ROOT=./data/media-multipart
OPENVIBE_MEDIA_CANONICAL_PROVIDER=local
OPENVIBE_MEDIA_HOT_PROVIDER=local
OPENVIBE_MEDIA_ASSET_ORIGIN_PROVIDER=local
OPENVIBE_MEDIA_COLD_PROVIDER=none

# Canonical cold storage settings.
OPENVIBE_MEDIA_COLD_S3_ENDPOINT=
OPENVIBE_MEDIA_COLD_S3_BUCKET=
OPENVIBE_MEDIA_COLD_S3_REGION=
OPENVIBE_MEDIA_COLD_S3_ACCESS_KEY_ID=
OPENVIBE_MEDIA_COLD_S3_SECRET_ACCESS_KEY=
OPENVIBE_MEDIA_COLD_S3_FORCE_PATH_STYLE=true

# Legacy cold storage aliases for backwards compatibility.
OPENVIBE_S3_ENDPOINT=
OPENVIBE_S3_BUCKET=
OPENVIBE_S3_REGION=
OPENVIBE_S3_ACCESS_KEY_ID=
OPENVIBE_S3_SECRET_ACCESS_KEY=
OPENVIBE_MEDIA_B2_BUCKET=
OPENVIBE_MEDIA_B2_ENDPOINT=
OPENVIBE_MEDIA_B2_KEY_ID=
OPENVIBE_MEDIA_B2_APPLICATION_KEY=
OPENVIBE_MEDIA_R2_BUCKET=
OPENVIBE_MEDIA_R2_ENDPOINT=
OPENVIBE_MEDIA_R2_ACCESS_KEY_ID=
OPENVIBE_MEDIA_R2_SECRET_ACCESS_KEY=

# Cutover guards.
# The staging loader and Postgres importer refuse to run unless explicitly
# enabled by the operator.
OPENVIBE_ALLOW_STAGING_LOAD=false
OPENVIBE_STAGING_CONFIRM=false
