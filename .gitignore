# Root-generated migration output
data/migrations/

# Prevent nested service runtime state and secrets from being tracked.
**/.package.lock.json
**/.env
**/.env.*
!**/.env.example
**/node_modules/
**/tmp/
**/temp/
**/.cache/
**/data/

# Runtime database artifacts
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*.sqlite
**/*.sqlite3

# Logs and temporary files
**/*.log
**/*.pid
**/*.seed

# Secrets and keys
.env
.env.*
!.env.example
.npmrc
.npmrc.*
!.npmrc.example
**/*.local
**/*.secret
**/*.secrets
**/.npmrc
**/.npmrc.*
!**/.npmrc.example
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
compat/fontawesome-pro-local/node_modules/
compat/fontawesome-pro-local/install.json
compat/fontawesome-pro-local/.tmp/

# Editor / environment
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db
**/*~
**/*.swp
**/*.swo
