NODE_ENV=production
OPENVIBE_ENV=production
OPENVIBE_PERSISTENCE_MODE=postgres
OPENVIBE_DATABASE_URL=postgres://openvibe:replace-me@postgres:5432/openvibe
OPENVIBE_REDIS_URL=redis://redis:6379
OPENVIBE_QUEUE_PREFIX=openvibe
INTERNAL_API_KEY=replace-me
OPENVIBE_PRIVATE_KEY=/opt/openvibe/services/openvibe-network/data/keys/openvibe-private.pem
OPENVIBE_PUBLIC_KEY=/opt/openvibe/services/openvibe-network/data/keys/openvibe-public.pem
OPENVIBE_AUTH_PUBLIC_KEY=/opt/openvibe/services/openvibe-network/data/keys/openvibe-public.pem
OPENVIBE_AUTH_JWKS_URL=https://auth.openvibe.network/.well-known/jwks.json
OPENVIBE_LEGACY_COMPAT_MODE=false
OPENVIBE_REALTIME_URL=https://realtime.openvibe.network
OPENVIBE_CODES_URL=https://openvibe.codes
OPENVIBE_BLOG_URL=https://openvibe.blog
OPENVIBE_WIKI_URL=https://openvibe.wiki
OPENVIBE_NEWS_URL=https://openvibe.news
OPENVIBE_REVIEWS_URL=https://openvibe.reviews
OPENVIBE_DEALS_URL=https://openvibe.deals
OPENVIBE_COUPONS_URL=https://openvibe.coupons
OPENVIBE_TRADE_URL=https://openvibe.trade

# Canonical media storage
OPENVIBE_MEDIA_COLD_PROVIDER=s3
OPENVIBE_MEDIA_COLD_S3_ENDPOINT=https://s3.us-west-000.backblazeb2.com
OPENVIBE_MEDIA_COLD_S3_BUCKET=replace-me-b2-bucket
OPENVIBE_MEDIA_COLD_S3_REGION=us-west-000

# Hot edge tier
OPENVIBE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
OPENVIBE_S3_BUCKET=replace-me-r2-bucket
OPENVIBE_S3_REGION=auto
