NODE_ENV=production
OPENVIBE_ENV=production
OPENVIBE_PERSISTENCE_MODE=postgres
OPENVIBE_DATABASE_URL=postgres://openvibe:replace-me@postgres:5432/openvibe
OPENVIBE_REDIS_URL=redis://redis:6379
OPENVIBE_QUEUE_PREFIX=openvibe
INTERNAL_API_KEY=replace-me
OPENVIBE_LEGACY_COMPAT_MODE=false

# Canonical media storage
OPENVIBE_MEDIA_COLD_PROVIDER=s3
OPENVIBE_MEDIA_COLD_S3_ENDPOINT=https://s3.us-west-000.backblazeb2.com
OPENVIBE_MEDIA_COLD_S3_BUCKET=replace-me-b2-bucket
OPENVIBE_MEDIA_COLD_S3_REGION=us-west-000

# Hot edge tier
OPENVIBE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
OPENVIBE_S3_BUCKET=replace-me-r2-bucket
OPENVIBE_S3_REGION=auto
