# Example Cloudflare real IP configuration.
# Copy to `/etc/nginx/conf.d/cloudflare-real-ip.conf` and keep the CIDRs up to date.

real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# Example placeholders only — replace with the current published Cloudflare ranges.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
