# openvibe-events service
PORT=4400
HOST=0.0.0.0

# Shared with openvibe-network and any consumer/publisher service.
INTERNAL_API_KEY=change-me-in-production

# SQLite location.
DB_PATH=./data/openvibe-events.db

# Production cutover target (documented now; current runtime still uses the
# local SQLite event/queue tables for bootstrap and testing).
OPENVIBE_CANONICAL_DATABASE_URL=
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

# Worker tuning.
DISPATCH_INTERVAL_MS=500
MAX_DELIVERY_ATTEMPTS=8
RETRY_BASE_MS=1000
