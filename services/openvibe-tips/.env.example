# openvibe-tips environment

PORT=5600
HOST=0.0.0.0
NODE_ENV=development

# Service auth — must match what other services use
INTERNAL_API_KEY=change-me-in-production

# Database path (default: ./data/openvibe-tips.db)
# DB_PATH=/var/data/openvibe-tips.db

# OpenVibe service URLs
OPENVIBE_EVENTS_URL=http://127.0.0.1:4400
OPENVIBE_NETWORK_URL=http://127.0.0.1:4100
OPENVIBE_BILLING_URL=http://127.0.0.1:5000

# Public base URL (used for auth redirects and overlay URLs)
# PUBLIC_BASE_URL=https://openvibe.tips

# Auth issuer (OpenVibe network)
# OPENVIBE_AUTH_ISSUER=https://openvibe.network
# OPENVIBE_AUTH_PUBLIC_KEY=/path/to/openvibe-public.pem

# ─── Connector secrets ───────────────────────────────────────────────────
# Streamlabs
# STREAMLABS_SOCKET_TOKEN=your-streamlabs-socket-token
# STREAMLABS_WEBHOOK_SECRET=your-streamlabs-webhook-secret

# StreamElements
# STREAMELEMENTS_JWT_SECRET=your-se-jwt-secret
# STREAMELEMENTS_CHANNEL_ID=your-channel-id

# PowerChat
# POWERCHAT_API_KEY=your-powerchat-api-key

# Generic webhooks are authenticated by the per-creator token stored in DB.
