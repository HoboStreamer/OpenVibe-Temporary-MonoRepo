# openre-stream defaults — copy to .env and edit for your environment.
PORT=4700
HOST=0.0.0.0
NODE_ENV=development

DB_PATH=./data/openre-stream.db
INTERNAL_API_KEY=change-me-in-production

OPENVIBE_EVENTS_URL=http://127.0.0.1:4400
OPENVIBE_NETWORK_URL=http://127.0.0.1:4100
OPENVIBE_LIVE_URL=http://127.0.0.1:4600
OPENVIBE_MEDIA_URL=http://127.0.0.1:4500

# Default RTMP/WHIP/JSMpeg ingest endpoints advertised to publishers.
INGEST_RTMP_URL=rtmp://ingest.openre.stream/live
INGEST_WHIP_URL=https://ingest.openre.stream/whip
INGEST_JSMPEG_URL=wss://ingest.openre.stream/jsmpeg
