# openvibe-media defaults — copy to .env and edit for your environment.
PORT=4500
HOST=0.0.0.0
NODE_ENV=development
OPENVIBE_ENV=local

OPENVIBE_PERSISTENCE_MODE=sqlite
OPENVIBE_DATABASE_URL=
DB_PATH=./data/openvibe-media.db
OPENVIBE_STAGING_DATABASE_URL=
OPENVIBE_ALLOW_STAGING_LOAD=false
OPENVIBE_STAGING_CONFIRM=false

# Production cutover target (documented now; current runtime still uses local
# SQLite metadata + STORAGE_ROOT for bootstrap).
OPENVIBE_CANONICAL_DATABASE_URL=
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

# Local hot-storage path for development, multipart scratch space, and cheap
# asset-origin bytes. Canonical VOD/clip/HLS storage is B2; R2 is hot-tier only.
OPENVIBE_MEDIA_HOT_ROOT=./data/storage/hot
OPENVIBE_MEDIA_MULTIPART_ROOT=./data/storage/multipart
STORAGE_ROOT=./data/storage/hot
OPENVIBE_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4500
PUBLIC_BASE_URL=http://127.0.0.1:4500

# Shared internal-key for service-to-service calls.
INTERNAL_API_KEY=change-me-in-production

# OpenVibe service URLs (used to fan media events into the shared bus).
OPENVIBE_EVENTS_URL=http://127.0.0.1:4400
OPENVIBE_NETWORK_URL=http://127.0.0.1:4100

# Optional auth so user-scoped uploads can verify JWTs against the OpenVibe
# auth surface. Falls back to internal-key+service header for service callers.
OPENVIBE_AUTH_ISSUER=http://auth.openvibe.network
OPENVIBE_AUTH_JWKS_URL=http://127.0.0.1:4100/.well-known/jwks.json

# OpenVibe media provider policy.
OPENVIBE_MEDIA_PROVIDER_POLICY=b2-default-r2-on-demand
STORAGE_PROVIDER=local
OPENVIBE_MEDIA_CANONICAL_PROVIDER=b2
OPENVIBE_MEDIA_DEFAULT_PLAYBACK_PROVIDER=b2
OPENVIBE_MEDIA_HOT_PROVIDER=r2
OPENVIBE_MEDIA_HOT_PROVIDER_ENABLED=false
OPENVIBE_MEDIA_R2_AUTO_PROMOTION_ENABLED=true
OPENVIBE_MEDIA_R2_REQUIRE_SITE_HOT=true
OPENVIBE_MEDIA_ASSET_ORIGIN_PROVIDER=local
OPENVIBE_MEDIA_COLD_PROVIDER=b2

# Public playback size guard rails + VOD part sizing.
OPENVIBE_MEDIA_PUBLIC_PLAYBACK_MAX_BYTES=524288000
OPENVIBE_MEDIA_TARGET_PUBLIC_OBJECT_BYTES=268435456
OPENVIBE_MEDIA_WARN_PUBLIC_OBJECT_BYTES=402653184
OPENVIBE_MEDIA_VOD_PART_TARGET_BYTES=268435456
OPENVIBE_MEDIA_VOD_PART_MAX_BYTES=524288000
OPENVIBE_MEDIA_VOD_PART_TARGET_SECONDS=1800
OPENVIBE_MEDIA_VOD_PART_MAX_SECONDS=3600

# Conservative R2 promotion thresholds. These should not light up R2 for a
# trivial 10-viewers/day site.
OPENVIBE_MEDIA_R2_SITE_MIN_UNIQUE_VIDEO_VIEWERS_7D=500
OPENVIBE_MEDIA_R2_SITE_MIN_WATCH_MINUTES_7D=25000
OPENVIBE_MEDIA_R2_SITE_MIN_ORIGIN_EGRESS_GB_7D=500
OPENVIBE_MEDIA_R2_SITE_MIN_CONCURRENT_VIEWERS=75
OPENVIBE_MEDIA_R2_VOD_MIN_UNIQUE_VIEWERS_24H=75
OPENVIBE_MEDIA_R2_VOD_MIN_UNIQUE_VIEWERS_7D=250
OPENVIBE_MEDIA_R2_VOD_MIN_WATCH_MINUTES_24H=1500
OPENVIBE_MEDIA_R2_VOD_MIN_WATCH_MINUTES_7D=5000
OPENVIBE_MEDIA_R2_VOD_MIN_CACHE_MISS_GB_24H=25
OPENVIBE_MEDIA_R2_VOD_MIN_CACHE_MISS_GB_7D=100
OPENVIBE_MEDIA_R2_CLIP_MIN_UNIQUE_VIEWERS_24H=40
OPENVIBE_MEDIA_R2_CLIP_MIN_UNIQUE_VIEWERS_7D=150
OPENVIBE_MEDIA_R2_CLIP_MIN_WATCH_MINUTES_24H=300
OPENVIBE_MEDIA_R2_CLIP_MIN_CACHE_MISS_GB_24H=10

# Canonical Backblaze B2 configuration.
OPENVIBE_MEDIA_B2_BUCKET=
OPENVIBE_MEDIA_B2_REGION=us-west-004
# Full URL required, for example https://s3.us-west-004.backblazeb2.com
OPENVIBE_MEDIA_B2_ENDPOINT=
OPENVIBE_MEDIA_B2_PUBLIC_BASE_URL=
OPENVIBE_MEDIA_B2_KEY_ID=
OPENVIBE_MEDIA_B2_APPLICATION_KEY=
OPENVIBE_MEDIA_B2_FORCE_PATH_STYLE=true

# Optional Cloudflare R2 hot tier.
OPENVIBE_MEDIA_R2_BUCKET=
OPENVIBE_MEDIA_R2_REGION=auto
# Full URL required, for example https://<account-id>.r2.cloudflarestorage.com
OPENVIBE_MEDIA_R2_ENDPOINT=
OPENVIBE_MEDIA_R2_PUBLIC_BASE_URL=
OPENVIBE_MEDIA_R2_ACCESS_KEY_ID=
OPENVIBE_MEDIA_R2_SECRET_ACCESS_KEY=
OPENVIBE_MEDIA_R2_FORCE_PATH_STYLE=false

# Backward-compatible generic cold-storage aliases.
OPENVIBE_MEDIA_COLD_S3_BUCKET=
OPENVIBE_MEDIA_COLD_S3_REGION=
OPENVIBE_MEDIA_COLD_S3_ENDPOINT=
OPENVIBE_MEDIA_COLD_S3_PUBLIC_BASE_URL=
OPENVIBE_MEDIA_COLD_S3_FORCE_PATH_STYLE=true

# Backward-compatible seam envs retained for existing configs.
S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
