PORT=5500
HOST=0.0.0.0
NODE_ENV=development
OPENVIBE_ENV=local

# Public origins can be overridden explicitly, but default to the shared
# *.localhost conventions via packages/openvibe-sdk/url-defaults.js.
OPENVIBE_CODES_URL=
OPENVIBE_BLOG_URL=
OPENVIBE_WIKI_URL=
OPENVIBE_NEWS_URL=
OPENVIBE_REVIEWS_URL=
OPENVIBE_DEALS_URL=
OPENVIBE_COUPONS_URL=
OPENVIBE_TRADE_URL=

# Optional control-plane helpers.
OPENVIBE_AI_URL=http://127.0.0.1:5100
OPENVIBE_NETWORK_URL=http://127.0.0.1:4100
OPENVIBE_REALTIME_URL=http://127.0.0.1:5400

# Public media object limits surfaced in SSR copy and readiness.
OPENVIBE_MEDIA_PUBLIC_PLAYBACK_MAX_BYTES=524288000
OPENVIBE_MEDIA_TARGET_PUBLIC_OBJECT_BYTES=268435456
OPENVIBE_MEDIA_WARN_PUBLIC_OBJECT_BYTES=402653184
