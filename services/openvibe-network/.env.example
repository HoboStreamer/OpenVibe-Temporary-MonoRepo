# openvibe-network service
PORT=4100
HOST=0.0.0.0

# Shared internal API key.
INTERNAL_API_KEY=change-me-in-production

# SQLite location.
DB_PATH=./data/openvibe-network.db

# Production cutover target (documented now; current runtime still boots from
# DB_PATH-backed SQLite locally).
OPENVIBE_CANONICAL_DATABASE_URL=
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

# Public URLs of the OpenVibe surfaces. The host-router uses these to decide
# what to render for a given request Host header.
OPENVIBE_NETWORK_URL=http://localhost:4100
OPENVIBE_AUTH_URL=http://auth.openvibe.network.localhost:4100
OPENVIBE_API_URL=http://api.openvibe.network.localhost:4100
OPENVIBE_ADMIN_URL=http://admin.openvibe.network.localhost:4100
OPENVIBE_MY_URL=http://my.openvibe.network.localhost:4100
OPENVIBE_THEMES_URL=http://themes.openvibe.network.localhost:4100

# Events backbone.
OPENVIBE_EVENTS_URL=http://localhost:4400

# Federation with the legacy hobo.tools install. When set, the OpenVibe
# network:
#   - trusts hobo.tools-issued JWTs (multi-issuer)
#   - exposes the hobo-tools public key in the JWKS
#   - proxies /admin /themes /my UIs through to hobo-tools as a transition
HOBO_TOOLS_URL=
HOBO_TOOLS_INTERNAL_URL=
HOBO_TOOLS_PUBLIC_KEY=

# OpenVibe RS256 keys (used for issuer-of-record mode after federation ends).
# Generate with:  openssl genrsa -out data/keys/openvibe-private.pem 2048
#                 openssl rsa -in data/keys/openvibe-private.pem -pubout -out data/keys/openvibe-public.pem
OPENVIBE_PRIVATE_KEY=./data/keys/openvibe-private.pem
OPENVIBE_PUBLIC_KEY=./data/keys/openvibe-public.pem
