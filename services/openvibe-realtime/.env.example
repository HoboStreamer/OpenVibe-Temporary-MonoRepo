PORT=5400
HOST=0.0.0.0
NODE_ENV=development

# Redis is optional for single-node local development, but required for
# distributed fanout, shared presence, and worker-backed production parity.
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

OPENVIBE_REALTIME_ALLOW_ANONYMOUS=true
OPENVIBE_REALTIME_PRESENCE_TTL_SECONDS=60
OPENVIBE_REALTIME_ENABLE_POLLING_TRANSPORT=false

INTERNAL_API_KEY=change-me-in-production
