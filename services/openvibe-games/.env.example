# openvibe-games — environment template

PORT=5200
HOST=0.0.0.0
NODE_ENV=development
OPENVIBE_ENV=local

INTERNAL_API_KEY=change-me-in-production

OPENVIBE_PERSISTENCE_MODE=sqlite
OPENVIBE_DATABASE_URL=
DB_PATH=./data/openvibe-games.db
OPENVIBE_STAGING_DATABASE_URL=
OPENVIBE_ALLOW_STAGING_LOAD=false
OPENVIBE_STAGING_CONFIRM=false
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

OPENVIBE_EVENTS_URL=http://127.0.0.1:4400
OPENVIBE_NETWORK_URL=http://127.0.0.1:4100
OPENVIBE_MEDIA_URL=http://127.0.0.1:4500
OPENVIBE_GAMES_URL=http://127.0.0.1:5200
OPENVIBE_GAMES_INTERNAL_URL=http://127.0.0.1:5200
PUBLIC_BASE_URL=http://127.0.0.1:5200

# Optional auth shims. For local/dev, routes also accept X-OpenVibe-User-* headers.
OPENVIBE_AUTH_ISSUER=
OPENVIBE_AUTH_JWKS_URL=

# Canvas defaults
OPENVIBE_GAMES_CANVAS_WIDTH=128
OPENVIBE_GAMES_CANVAS_HEIGHT=128
OPENVIBE_GAMES_CANVAS_TILE_COOLDOWN_SECONDS=15
OPENVIBE_GAMES_CANVAS_PLACEMENTS_PER_MINUTE=8
