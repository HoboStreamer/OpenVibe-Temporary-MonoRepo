# openvibe-chat — environment template

PORT=4800
HOST=0.0.0.0
NODE_ENV=development
OPENVIBE_ENV=local

# Internal service auth (X-Internal-Key + X-OpenVibe-Service)
INTERNAL_API_KEY=change-me-in-production

# Local-dev SQLite path. Staging/prod should set OPENVIBE_PERSISTENCE_MODE=postgres.
OPENVIBE_PERSISTENCE_MODE=sqlite
OPENVIBE_DATABASE_URL=
DB_PATH=./data/openvibe-chat.db
OPENVIBE_STAGING_DATABASE_URL=
OPENVIBE_ALLOW_STAGING_LOAD=false
OPENVIBE_STAGING_CONFIRM=false

# Production cutover target (documented now; current runtime still boots from
# DB_PATH-backed SQLite locally).
OPENVIBE_CANONICAL_DATABASE_URL=
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

# OpenVibe kernel URLs
OPENVIBE_EVENTS_URL=http://127.0.0.1:4400
OPENVIBE_NETWORK_URL=http://openvibe.network.localhost:4100
OPENVIBE_MEDIA_URL=http://127.0.0.1:4500
OPENVIBE_LIVE_URL=http://127.0.0.1:4600

# Auth (recommended for native browser sign-in + DM flows)
OPENVIBE_AUTH_ISSUER=http://auth.openvibe.network.localhost:4100
OPENVIBE_AUTH_PUBLIC_KEY=../openvibe-network/data/keys/openvibe-public.pem
OPENVIBE_AUTH_JWKS_URL=

PUBLIC_BASE_URL=http://openvibe.chat.localhost:4800
