# openvibe-chat — environment template

PORT=4800
HOST=0.0.0.0
NODE_ENV=development

# Internal service auth (X-Internal-Key + X-OpenVibe-Service)
INTERNAL_API_KEY=change-me-in-production

# SQLite path
DB_PATH=./data/openvibe-chat.db

# Production cutover target (documented now; current runtime still boots from
# DB_PATH-backed SQLite locally).
OPENVIBE_CANONICAL_DATABASE_URL=
OPENVIBE_REDIS_URL=
OPENVIBE_QUEUE_PREFIX=openvibe

# OpenVibe kernel URLs
OPENVIBE_EVENTS_URL=http://127.0.0.1:4400
OPENVIBE_NETWORK_URL=http://127.0.0.1:4100
OPENVIBE_MEDIA_URL=http://127.0.0.1:4500
OPENVIBE_LIVE_URL=http://127.0.0.1:4600

# Auth (optional — falls back to anonymous + service-actor only)
OPENVIBE_AUTH_ISSUER=
OPENVIBE_AUTH_JWKS_URL=

PUBLIC_BASE_URL=http://127.0.0.1:4800
